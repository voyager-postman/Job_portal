# Password encryption in login/register payload (enabled by default).
# Payload shows: password = "enc:v1:<base64>" instead of plain text.
# Backend must use docs/backend-password-decrypt.example.js before bcrypt.
# REACT_APP_PASSWORD_ENCRYPTION_ENABLED=false
# REACT_APP_PASSWORD_ENCRYPTION_SECRET=your-shared-secret-here

# Public site URL used in canonical links and JSON-LD (no trailing slash).
# Example: https://connectwork.ma
# REACT_APP_SITE_URL=https://itdevelopmentservices.com/jobPortal
# REACT_APP_API_URL=https://sisccltd.com/job_portal/api/
# REACT_APP_LOGIN_PUBLIC_KEY_PEM="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"
